<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
	<PropertyGroup>
		<Version>0.8.9.1</Version>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<Author>Anomaly</Author>
		<Name>Eorzea Timers</Name>
		<Punchline>Create and track personalized timers in FFXIV.</Punchline>
		<Description>Open-source FFXIV timers with customizable alerts, game-linked countdowns, and an in-game overlay.</Description>
		<RepoUrl>https://github.com/anomalousgamer/EorzeaTimers</RepoUrl>
		<Tags>timer;countdown;reminder</Tags>
	</PropertyGroup>

	<ItemGroup>
		<Content Include="..\LICENSE.md">
			<Link>LICENSE.md</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<Visible>false</Visible>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<None Include="..\repo.json" Link="repo.json" />
	</ItemGroup>

</Project>
